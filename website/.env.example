# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Whitelabeled backend base URL (plan 15). Unset → the site renders the
# built-in Peña Nevada fallbacks with zero fetches. The PUBLIC_ prefix makes it
# a build-time inline; at runtime the wrangler var API_BASE_URL wins over it.
PUBLIC_API_BASE_URL=
