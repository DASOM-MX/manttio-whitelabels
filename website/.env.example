# Public contact info shown on the marketing site.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The PUBLIC_ prefix is required so Astro inlines these into the static build.

# Display format (with spaces is fine, e.g. "+52 81 0000 0000").
PUBLIC_CONTACT_PHONE="+52 81 0000 0000"

# Email address used for the mailto: link and the visible label.
PUBLIC_CONTACT_EMAIL="contacto@penanevadachillers.com"
