---
import { filled } from '../lib/content';
import type { Brand, CmsHome } from '../lib/types';

interface Props {
  brand: Brand;
  home: CmsHome;
}

const { brand, home } = Astro.props;

// CMS-provided background video (04 §6 v1.1); empty falls back to the gradient.
const heroVideoUrl = filled(home.hero_video_url) ?? '';

const rotatorWords = home.service_targets.length ? home.service_targets : ['Negocio'];
const metrics = home.badges;
---

<section class="relative isolate flex min-h-screen items-center overflow-hidden bg-granite-900">
  {heroVideoUrl && (
    <video
      class="absolute inset-0 size-full object-cover"
      src={heroVideoUrl}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>
  )}

  <div
    class="absolute inset-0 bg-gradient-to-br from-granite-1000/85 via-granite-900/70 to-granite-800/60"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute -left-32 top-1/3 size-96 rounded-full bg-cyan-500/25 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -right-24 bottom-10 size-80 rounded-full bg-navy-500/25 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto flex w-full max-w-7xl flex-col items-start px-6 py-32 lg:px-10 lg:py-40">
    <h1 class="max-w-3xl font-heading text-4xl font-bold leading-[1.05] text-white sm:text-5xl lg:text-7xl">
      {home.title}
      <span class="mt-2 block">
        <span
          class="inline-block text-cyan-400"
          data-hero-rotator
          data-hero-words={JSON.stringify(rotatorWords)}
        >{rotatorWords[0]}</span>
      </span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-granite-100 sm:text-xl">
      {home.description}
    </p>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a
        href="/contact-us"
        class="inline-flex items-center justify-center rounded-md bg-cyan-500 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-cyan-500/25 transition hover:bg-cyan-600 focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2 focus:ring-offset-granite-900"
      >
        Solicitar cotización
      </a>
      <a
        href="#servicios"
        class="inline-flex items-center justify-center rounded-md border border-white/25 bg-white/5 px-7 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/50"
      >
        Ver nuestros servicios
      </a>
    </div>

    <div class="mt-16 w-full border-t border-white/10 pt-10">
      <dl class="mx-auto grid max-w-3xl grid-cols-3 gap-6 text-center sm:gap-10 lg:mx-0 lg:text-left">
        {metrics.map((m) => (
          <div>
            <dt class="text-xs font-semibold uppercase tracking-caps text-white/60 sm:text-sm">
              {m.heading}
            </dt>
            <dd class="mt-2 font-heading text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
              {m.value}
              {m.description && (
                <span class="ml-1 text-base font-medium text-white/70 sm:text-lg">
                  {m.description}
                </span>
              )}
            </dd>
          </div>
        ))}
      </dl>
      {brand.slogan && (
        <p class="mt-10 text-center text-lg font-medium uppercase tracking-caps text-sky-300 sm:text-xl lg:text-left">
          {brand.slogan}
        </p>
      )}
    </div>
  </div>
</section>

<script>
  import anime from 'animejs';

  const rotator = document.querySelector<HTMLElement>('[data-hero-rotator]');
  if (rotator) {
    let words: string[] = [];
    try {
      words = JSON.parse(rotator.dataset.heroWords ?? '[]');
    } catch {
      words = [];
    }
    if (words.length > 1) {
      let idx = 0;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const intervalMs = 2800;

      const swap = () => {
        const nextIdx = (idx + 1) % words.length;

        if (prefersReducedMotion) {
          idx = nextIdx;
          rotator.textContent = words[idx];
          return;
        }

        anime({
          targets: rotator,
          opacity: [1, 0],
          translateY: [0, -14],
          duration: 320,
          easing: 'easeInQuad',
          complete: () => {
            idx = nextIdx;
            rotator.textContent = words[idx];
            anime({
              targets: rotator,
              opacity: [0, 1],
              translateY: [14, 0],
              duration: 420,
              easing: 'easeOutQuad',
            });
          },
        });
      };

      setInterval(swap, intervalMs);
    }
  }
</script>
