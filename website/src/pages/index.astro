---
// Server-rendered (plan 15 §2): brand + published CMS content are fetched per
// request, so a superadmin publish is live on the next page load — never baked
// into a static build.
export const prerender = false;

import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Clients from '../components/Clients.astro';
import Location from '../components/Location.astro';
import Manufacturers from '../components/Manufacturers.astro';
import Footer from '../components/Footer.astro';
import { getSiteData } from '../lib/api';
import { buildBrandCss } from '../lib/theme';

const { brand, home, clients, fonts } = await getSiteData();
const brandCss = buildBrandCss(brand, fonts);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://penanevadachillers.com';
const canonicalUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const requestOrigin = new URL(Astro.request.url).origin;
const pageTitle = `${brand.name} — ${home.services_content.title}`;
// brand.description is the business blurb (03 §2 — the site's meta
// description); the hero lede is only a fallback.
const pageDescription = brand.description?.trim() ? brand.description : home.description;
const toAbsolute = (url: string | undefined, fallback: string) => {
  const path = url ?? fallback;
  return /^https?:\/\//.test(path) ? path : `${requestOrigin}${path}`;
};
const ogImage = toAbsolute(brand.logoUrl, '/brand/penanevada-full-light.png');
const faviconUrl = brand.isologoUrl ?? '/brand/penanevada-mark.png';
const socialUrls = Object.values(brand.social ?? {}).filter(
  (url): url is string => typeof url === 'string' && url.length > 0,
);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: brand.name,
  url: siteUrl,
  logo: ogImage,
  image: ogImage,
  description: pageDescription,
  ...(brand.contact?.address
    ? { address: { '@type': 'PostalAddress', streetAddress: brand.contact.address, addressCountry: 'MX' } }
    : {}),
  ...(brand.contact?.phone ? { telephone: brand.contact.phone } : {}),
  ...(socialUrls.length ? { sameAs: socialUrls } : {}),
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c4a6e" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    <link rel="canonical" href={canonicalUrl} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={brand.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={brand.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={brand.name} />

    {socialUrls.map((url) => <link rel="me" href={url} />)}

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {brandCss && <style is:inline set:html={brandCss}></style>}
  </head>
  <body class="min-h-screen bg-granite-50 text-granite-900 antialiased">
    <Header brand={brand} />
    <main>
      <Hero brand={brand} home={home} />
      <Services home={home} />
      <Clients brand={brand} home={home} clients={clients} />
      <Location brand={brand} home={home} />
      <Manufacturers home={home} />
    </main>
    <Footer brand={brand} home={home} />
  </body>
</html>
