---
import { contact } from '../lib/contact';

const address = 'Gral. Plutarco Elías Calles 2403, Guadalupe, Nuevo León 67169';
const mapEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;

const contactItems = [
  {
    label: 'Dirección',
    value: 'Gral. Plutarco Elías Calles #2403',
    sub: 'Guadalupe, Nuevo León 67169',
    iconPath:
      'M12 21s-7-7.5-7-12a7 7 0 0 1 14 0c0 4.5-7 12-7 12zM12 11a2 2 0 1 1 0-4 2 2 0 0 1 0 4z',
  },
  {
    label: 'Teléfono',
    value: contact.phone,
    sub: 'Lun a vie, 8:00 – 18:00',
    href: contact.phoneHref,
    iconPath:
      'M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92z',
  },
  {
    label: 'Correo',
    value: contact.email,
    sub: 'Respondemos en menos de 24 h',
    href: contact.emailHref,
    iconPath:
      'M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM22 8l-10 7L2 8',
  },
];
---

<section
  id="ubicacion"
  class="overflow-x-clip bg-granite-900 py-20 lg:flex lg:min-h-screen lg:items-center lg:py-14"
  data-location-section
>
  <div class="mx-auto w-full max-w-7xl lg:px-10">
    <div class="max-w-3xl px-6 lg:px-0">
      <p class="text-sm font-semibold uppercase tracking-caps text-sky-400" data-location-eyebrow>
        Ubicación
      </p>
      <h2 class="mt-3 font-heading text-3xl font-bold text-white sm:text-4xl lg:text-5xl" data-location-heading>
        Al pie del corredor industrial de Guadalupe
      </h2>
      <p class="mt-5 text-lg text-white/75" data-location-lede>
        Operamos desde Nuevo León para todo el noreste del país. Visítanos, agenda una cita o contáctanos directamente.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-5 lg:items-stretch lg:gap-10">
      <div class="min-w-0 space-y-6 px-6 lg:col-span-2 lg:px-0" data-location-info>
        <ul class="min-w-0 space-y-4">
          {contactItems.map((item) => (
            <li class="flex min-w-0 items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-5 transition hover:border-white/20 hover:bg-white/10">
              <div class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg bg-cyan-500/20 text-cyan-300">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-5"
                  aria-hidden="true"
                >
                  <path d={item.iconPath} />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold uppercase tracking-wider text-white/60">
                  {item.label}
                </p>
                {item.href ? (
                  <a
                    href={item.href}
                    class="mt-1 block break-words font-heading text-lg font-semibold text-white transition hover:text-cyan-300 focus:outline-none focus:text-cyan-300"
                  >
                    {item.value}
                  </a>
                ) : (
                  <p class="mt-1 break-words font-heading text-lg font-semibold text-white">
                    {item.value}
                  </p>
                )}
                <p class="mt-0.5 break-words text-sm text-white/70">{item.sub}</p>
              </div>
            </li>
          ))}
        </ul>

        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md bg-cyan-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-600 focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2 focus:ring-offset-granite-900"
        >
          Cómo llegar
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div
        class="w-full min-w-0 max-w-full overflow-hidden lg:col-span-3 lg:rounded-2xl lg:border lg:border-white/10 lg:shadow-2xl lg:shadow-granite-950/50"
        data-location-map
      >
        <div
          class="relative h-80 w-full sm:h-96 lg:h-full"
          data-location-map-frame
          data-map-src={mapEmbedSrc}
        >
          <div
            class="absolute inset-0 flex items-center justify-center bg-granite-800/60 text-sm text-white/60"
            data-location-map-placeholder
          >
            Cargando mapa…
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import anime from 'animejs';

  const mapFrame = document.querySelector<HTMLElement>('[data-location-map-frame]');
  if (mapFrame) {
    const mapSrc = mapFrame.dataset.mapSrc;
    const placeholder = mapFrame.querySelector<HTMLElement>('[data-location-map-placeholder]');

    const measureWidth = () => {
      const frameWidth = Math.floor(mapFrame.getBoundingClientRect().width);
      const viewportWidth = Math.floor(document.documentElement.clientWidth || window.innerWidth);
      const usable = Math.min(frameWidth, viewportWidth);
      return usable > 0 ? usable : 0;
    };

    const mountMap = () => {
      if (!mapSrc || mapFrame.querySelector('iframe')) return;

      const width = measureWidth();
      if (width <= 0) return;

      const iframe = document.createElement('iframe');
      iframe.title = 'Mapa — Peña Nevada Chillers';
      iframe.src = mapSrc;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 block h-full border-0';
      iframe.style.width = `${width}px`;
      iframe.style.maxWidth = '100%';

      iframe.addEventListener('load', () => {
        if (placeholder) placeholder.remove();
      }, { once: true });

      mapFrame.appendChild(iframe);
    };

    const updateWidth = () => {
      const iframe = mapFrame.querySelector<HTMLIFrameElement>('iframe');
      if (!iframe) return;
      const width = measureWidth();
      if (width > 0) iframe.style.width = `${width}px`;
    };

    if (document.readyState === 'complete') {
      mountMap();
    } else {
      window.addEventListener('load', mountMap, { once: true });
    }

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(updateWidth, 150);
    });
  }

  const section = document.querySelector<HTMLElement>('[data-location-section]');
  if (section) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const eyebrow = section.querySelector<HTMLElement>('[data-location-eyebrow]');
    const heading = section.querySelector<HTMLElement>('[data-location-heading]');
    const lede = section.querySelector<HTMLElement>('[data-location-lede]');
    const info = section.querySelector<HTMLElement>('[data-location-info]');
    const map = section.querySelector<HTMLElement>('[data-location-map]');

    const targets = [eyebrow, heading, lede, info, map].filter(
      (el): el is HTMLElement => !!el,
    );

    if (prefersReducedMotion) {
      targets.forEach((el) => {
        el.style.opacity = '1';
      });
    } else {
      targets.forEach((el) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
      });

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              anime({
                targets,
                opacity: [0, 1],
                translateY: [24, 0],
                duration: 820,
                delay: anime.stagger(110),
                easing: 'easeOutCubic',
              });
              obs.disconnect();
            }
          });
        },
        { threshold: 0.15 },
      );
      observer.observe(section);
    }
  }
</script>
