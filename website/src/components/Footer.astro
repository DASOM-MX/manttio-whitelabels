---
import type { Brand, CmsHome } from '../lib/types';
import { DEFAULT_HOME } from '../lib/defaults';

interface Props {
  brand: Brand;
  home: CmsHome;
}

const { brand, home } = Astro.props;

const year = new Date().getFullYear();
const phone = brand.contact?.phone;
const phoneHref = phone ? `tel:${phone.replace(/\s+/g, '')}` : undefined;
const email = brand.contact?.email;
const emailHref = email ? `mailto:${email}` : undefined;
const cta = home.contact_cta ?? DEFAULT_HOME.contact_cta!;
// Footer blurb ← brand.description (plan 15 §4); services title + area as fallback.
const blurb =
  brand.description?.trim() || `${home.services_content.title}. ${home.service_area ?? ''}`.trim();

const quickLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#ubicacion', label: 'Ubicación' },
  { href: '#marcas', label: 'Marcas' },
];

const contactItems = [
  ...(phone ? [{ label: 'Teléfono', value: phone, href: phoneHref }] : []),
  ...(email ? [{ label: 'Correo', value: email, href: emailHref }] : []),
  ...(brand.contact?.address ? [{ label: 'Dirección', value: brand.contact.address }] : []),
];
---

<footer class="bg-granite-950 text-white" data-footer>
  <div id="contacto" class="border-b border-white/10">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-5 lg:items-center lg:gap-16">
        <div class="lg:col-span-3" data-footer-cta-text>
          <p class="text-sm font-semibold uppercase tracking-caps text-cyan-400">
            Contacto
          </p>
          <h2 class="mt-3 font-heading text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
            {cta.title}
          </h2>
          <p class="mt-5 max-w-2xl text-lg text-white/75">
            {cta.description}
          </p>
        </div>

        <div class="flex flex-col gap-3 lg:col-span-2" data-footer-cta-actions>
          {phoneHref && (
          <a
            href={phoneHref}
            class="inline-flex items-center justify-center gap-3 rounded-md bg-cyan-500 px-6 py-4 text-base font-semibold text-white shadow-lg shadow-cyan-500/25 transition hover:bg-cyan-600 focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2 focus:ring-offset-granite-950"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>Llamar al {phone}</span>
          </a>
          )}
          {emailHref && (
          <a
            href={emailHref}
            class="inline-flex items-center justify-center gap-3 rounded-md border border-white/25 bg-white/5 px-6 py-4 text-base font-semibold text-white backdrop-blur-sm transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/50"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <path d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM22 8l-10 7L2 8" />
            </svg>
            <span>Enviar correo</span>
          </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-14 lg:px-10">
    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      <div>
        <a
          href="/"
          class="inline-flex items-center"
          aria-label={brand.name}
        >
          {brand.isologoUrl && (
            <img
              src={brand.isologoUrl}
              alt={brand.name}
              width="64"
              height="64"
              class="size-14 rounded-full bg-white p-0.5 shadow-sm sm:size-16"
            />
          )}
        </a>
        <p class="mt-4 max-w-xs text-sm text-white/65">
          {blurb}
        </p>
        {brand.slogan && (
          <p class="mt-5 text-xs font-semibold uppercase tracking-caps text-sky-300">
            {brand.slogan}
          </p>
        )}
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-caps text-white/60">
          Sitio
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-white/80">
          {quickLinks.map((l) => (
            <li>
              <a href={l.href} class="transition hover:text-cyan-300">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-caps text-white/60">
          Contacto directo
        </h3>
        <ul class="mt-4 space-y-3 text-sm">
          {contactItems.map((item) => (
            <li>
              <p class="text-white/55">{item.label}</p>
              {item.href ? (
                <a
                  href={item.href}
                  class="mt-0.5 block font-medium text-white transition hover:text-cyan-300"
                >
                  {item.value}
                </a>
              ) : (
                <p class="mt-0.5 font-medium text-white">{item.value}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-sm text-white/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {brand.name}. Todos los derechos reservados.</p>
      <p>Diseñado y construido en Nuevo León.</p>
    </div>
  </div>
</footer>

<script>
  import anime from 'animejs';

  const footer = document.querySelector<HTMLElement>('[data-footer]');
  if (footer) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const text = footer.querySelector<HTMLElement>('[data-footer-cta-text]');
    const actions = footer.querySelector<HTMLElement>('[data-footer-cta-actions]');

    const targets = [text, actions].filter((el): el is HTMLElement => !!el);

    if (prefersReducedMotion) {
      targets.forEach((el) => {
        el.style.opacity = '1';
      });
    } else {
      targets.forEach((el) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
      });

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              anime({
                targets,
                opacity: [0, 1],
                translateY: [24, 0],
                duration: 800,
                delay: anime.stagger(140),
                easing: 'easeOutCubic',
              });
              obs.disconnect();
            }
          });
        },
        { threshold: 0.2 },
      );
      observer.observe(footer);
    }
  }
</script>
