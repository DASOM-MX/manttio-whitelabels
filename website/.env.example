# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Whitelabeled backend base URL (plan 15). Unset → the site renders the
# built-in brand-neutral fallbacks with zero fetches. The PUBLIC_ prefix makes
# it a build-time inline; at runtime the wrangler var API_BASE_URL wins over it.
# Local dev against the local backend: http://127.0.0.1:8787
PUBLIC_API_BASE_URL=

# Turnstile site key for the /contact-us form (utm-params plan 02). Same
# runtime-first rule: the wrangler var TURNSTILE_SITE_KEY wins over this
# build-time inline. The value below is Cloudflare's always-pass test key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
