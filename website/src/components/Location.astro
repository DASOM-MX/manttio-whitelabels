---
const address = 'Vereda Tropical #26, Col. Dos Ríos, Guadalupe, Nuevo León 67134';
const mapEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;

// TODO: replace phone and email placeholders with real business contact data.
const contactItems = [
  {
    label: 'Dirección',
    value: 'Vereda Tropical #26',
    sub: 'Col. Dos Ríos, Guadalupe, Nuevo León 67134',
    iconPath:
      'M12 21s-7-7.5-7-12a7 7 0 0 1 14 0c0 4.5-7 12-7 12zM12 11a2 2 0 1 1 0-4 2 2 0 0 1 0 4z',
  },
  {
    label: 'Teléfono',
    value: '+52 81 0000 0000',
    sub: 'Lun a vie, 8:00 – 18:00',
    iconPath:
      'M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92z',
  },
  {
    label: 'Correo',
    value: 'contacto@penanevadachillers.com',
    sub: 'Respondemos en menos de 24 h',
    iconPath:
      'M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM22 8l-10 7L2 8',
  },
];
---

<section
  id="ubicacion"
  class="overflow-x-clip bg-granite-900 py-20 lg:flex lg:min-h-screen lg:items-center lg:py-14"
  data-location-section
>
  <div class="mx-auto w-full max-w-7xl px-6 lg:px-10">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-caps text-golden-400" data-location-eyebrow>
        Ubicación
      </p>
      <h2 class="mt-3 font-heading text-3xl font-bold text-white sm:text-4xl lg:text-5xl" data-location-heading>
        Al pie del corredor industrial de Guadalupe
      </h2>
      <p class="mt-5 text-lg text-white/75" data-location-lede>
        Operamos desde Nuevo León para todo el noreste del país. Visítanos, agenda una cita o contáctanos directamente.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-5 lg:items-stretch lg:gap-10">
      <div class="space-y-6 lg:col-span-2" data-location-info>
        <ul class="space-y-4">
          {contactItems.map((item) => (
            <li class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-5 transition hover:border-white/20 hover:bg-white/10">
              <div class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg bg-coral-500/20 text-coral-300">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-5"
                  aria-hidden="true"
                >
                  <path d={item.iconPath} />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-wider text-white/60">
                  {item.label}
                </p>
                <p class="mt-1 font-heading text-lg font-semibold text-white">
                  {item.value}
                </p>
                <p class="mt-0.5 text-sm text-white/70">{item.sub}</p>
              </div>
            </li>
          ))}
        </ul>

        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md bg-coral-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-coral-500/20 transition hover:bg-coral-600 focus:outline-none focus:ring-2 focus:ring-coral-300 focus:ring-offset-2 focus:ring-offset-granite-900"
        >
          Cómo llegar
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div
        class="min-w-0 overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-granite-950/50 lg:col-span-3"
        data-location-map
      >
        <iframe
          title="Mapa — Peña Nevada Chillers"
          src={mapEmbedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-80 w-full max-w-full border-0 sm:h-96 lg:size-full"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  import anime from 'animejs';

  const section = document.querySelector<HTMLElement>('[data-location-section]');
  if (section) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const eyebrow = section.querySelector<HTMLElement>('[data-location-eyebrow]');
    const heading = section.querySelector<HTMLElement>('[data-location-heading]');
    const lede = section.querySelector<HTMLElement>('[data-location-lede]');
    const info = section.querySelector<HTMLElement>('[data-location-info]');
    const map = section.querySelector<HTMLElement>('[data-location-map]');

    const targets = [eyebrow, heading, lede, info, map].filter(
      (el): el is HTMLElement => !!el,
    );

    if (prefersReducedMotion) {
      targets.forEach((el) => {
        el.style.opacity = '1';
      });
    } else {
      targets.forEach((el) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
      });

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              anime({
                targets,
                opacity: [0, 1],
                translateY: [24, 0],
                duration: 820,
                delay: anime.stagger(110),
                easing: 'easeOutCubic',
              });
              obs.disconnect();
            }
          });
        },
        { threshold: 0.15 },
      );
      observer.observe(section);
    }
  }
</script>
