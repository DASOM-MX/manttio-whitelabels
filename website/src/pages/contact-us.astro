---
// Public contact page (utm-params plan 02 CP-2). Server-rendered like index:
// brand + runtime config resolve per request, so tenant provisioning is live
// on the next load without a rebuild.
export const prerender = false;

import '../styles/global.css';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import UtmCapture from '../components/UtmCapture.astro';
import { getSiteData, resolveBaseUrl } from '../lib/api';
import { resolveRuntimeVar } from '../lib/runtime-env';
import { buildBrandCss } from '../lib/theme';

const { brand, home, fonts } = await getSiteData();
const brandCss = buildBrandCss(brand, fonts);

const apiBase = await resolveBaseUrl();
const siteKey = await resolveRuntimeVar('TURNSTILE_SITE_KEY', 'PUBLIC_TURNSTILE_SITE_KEY');
const formEnabled = Boolean(apiBase && siteKey);

const requestOrigin = new URL(Astro.request.url).origin;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? requestOrigin;
const canonicalUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const pageTitle = `${brand.name} — Contacto`;
const pageDescription = brand.description?.trim() ? brand.description : home.description;
const toAbsolute = (path: string) => (path.startsWith('/') ? `${requestOrigin}${path}` : path);
const ogImage = toAbsolute(brand.logoUrl || '/og-default.png');
const faviconUrl = brand.isologoUrl || '/favicon.svg';
const faviconType = faviconUrl.endsWith('.svg') ? 'image/svg+xml' : 'image/png';
const appleTouchUrl = brand.isologoUrl || '/apple-touch-icon.png';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c4a6e" />
    <link rel="icon" type={faviconType} href={faviconUrl} />
    <link rel="apple-touch-icon" href={appleTouchUrl} />
    <link rel="canonical" href={canonicalUrl} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={brand.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={brand.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={brand.name} />

    {
      formEnabled && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }
    {brandCss && <style is:inline set:html={brandCss}></style>}
  </head>
  <body class="min-h-screen bg-granite-0 text-granite-900 antialiased">
    <Header brand={brand} />
    <main>
      <section class="bg-granite-1000 pb-14 pt-32 sm:pt-36">
        <div class="mx-auto max-w-7xl px-6 lg:px-10">
          <p class="text-sm font-semibold uppercase tracking-caps text-cyan-400">Contacto</p>
          <h1 class="mt-3 font-heading text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
            Contáctanos
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-white/75">
            Cuéntanos qué necesitas y un especialista te contacta en menos de 24 horas.
          </p>
        </div>
      </section>
      <ContactForm apiBase={apiBase} siteKey={siteKey} brand={brand} />
    </main>
    <Footer brand={brand} home={home} />
    <UtmCapture />
  </body>
</html>
