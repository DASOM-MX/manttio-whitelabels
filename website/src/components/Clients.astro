---
import { filled } from '../lib/content';
import type { Brand, CmsClient, CmsHome } from '../lib/types';

interface Props {
  brand: Brand;
  home: CmsHome;
  clients: CmsClient[];
}

const { brand, home, clients } = Astro.props;

const industries = [...new Set(clients.map((c) => c.sector).filter((s): s is string => !!s))];

// Section copy from the CMS (04 §6 v1.1); each field falls back to the
// original Peña Nevada copy so a blank group renders the site unchanged.
const cc = home.clients_content;
const ccTitle = filled(cc?.title);
const ccLede =
  filled(cc?.description) ??
  `Una selección de empresas que han elegido a ${brand.name} para diseñar, instalar y mantener su climatización industrial — desde cadena de frío y empaque hasta servicios públicos y renta de equipo.`;
---

<section
  id="clientes"
  class="relative isolate overflow-hidden bg-granite-50 py-20 lg:py-28"
  data-clients-section
>
  <div
    class="pointer-events-none absolute -right-24 -top-24 size-96 rounded-full bg-sky-200/40 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -left-24 bottom-0 size-80 rounded-full bg-cyan-200/30 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3">
        <span
          class="block h-px w-10 origin-left bg-cyan-500"
          data-clients-line
          aria-hidden="true"
        ></span>
        <p
          class="text-sm font-semibold uppercase tracking-caps text-cyan-600"
          data-clients-eyebrow
        >
          {filled(cc?.eyebrow) ?? 'Clientes'}
        </p>
      </div>
      <h2
        class="mt-4 font-heading text-3xl font-bold text-granite-900 sm:text-4xl lg:text-5xl"
        data-clients-heading
      >
        {ccTitle ?? (
          <Fragment>
            Construyendo confianza,
            <span class="text-cyan-600">proyecto por proyecto</span>.
          </Fragment>
        )}
      </h2>
      <p
        class="mt-5 text-lg text-granite-700"
        data-clients-lede
      >
        {ccLede}
      </p>
    </div>

    <div class="mt-8 flex flex-wrap gap-2" data-clients-chips-row>
      {industries.map((tag) => (
        <span
          class="inline-flex items-center rounded-full border border-granite-200 bg-white px-3 py-1 text-xs font-medium text-granite-700 shadow-sm"
          data-clients-chip
        >
          {tag}
        </span>
      ))}
    </div>

    <div
      class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6"
      data-clients-grid
    >
      {clients.map((c) => (
        <article
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-granite-200 bg-white transition-colors duration-300 hover:border-cyan-300 hover:shadow-xl hover:shadow-cyan-500/10"
          data-client-card
        >
          <div class="flex h-28 items-center justify-center px-6 sm:h-32">
            <img
              src={c.logoUrl}
              alt={c.name}
              loading="lazy"
              decoding="async"
              class="max-h-16 w-auto max-w-full object-contain opacity-75 grayscale transition duration-500 group-hover:opacity-100 group-hover:grayscale-0 sm:max-h-20"
            />
          </div>
          <div class="border-t border-granite-100 px-6 py-4">
            <p class="line-clamp-2 font-heading text-base font-bold text-granite-900">
              {c.name}
            </p>
            {c.legal && (
              <p class="mt-0.5 text-xs text-granite-400">{c.legal}</p>
            )}
            {c.sector && <p class="mt-1 text-sm text-granite-500">{c.sector}</p>}
          </div>
          <span class="pointer-events-none absolute inset-0" aria-hidden="true">
            <span class="absolute bottom-0 left-0 right-1/2 h-0.5 origin-right scale-x-0 bg-cyan-500" data-trail="bl"></span>
            <span class="absolute bottom-0 left-1/2 right-0 h-0.5 origin-left scale-x-0 bg-cyan-500" data-trail="br"></span>
            <span class="absolute inset-y-0 left-0 w-0.5 origin-bottom scale-y-0 bg-cyan-500" data-trail="l"></span>
            <span class="absolute inset-y-0 right-0 w-0.5 origin-bottom scale-y-0 bg-cyan-500" data-trail="r"></span>
            <span class="absolute left-0 right-1/2 top-0 h-0.5 origin-left scale-x-0 bg-cyan-500" data-trail="tl"></span>
            <span class="absolute left-1/2 right-0 top-0 h-0.5 origin-right scale-x-0 bg-cyan-500" data-trail="tr"></span>
          </span>
        </article>
      ))}
    </div>

    <div
      class="mt-12 flex flex-col items-start gap-4 rounded-2xl border border-granite-200 bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-8"
      data-clients-cta
    >
      <div>
        <p class="font-heading text-lg font-bold text-granite-900 sm:text-xl">
          {filled(cc?.cta_title) ?? '¿Quieres ser nuestro próximo proyecto?'}
        </p>
        <p class="mt-1 text-sm text-granite-600">
          {filled(cc?.cta_description) ??
            'Cuéntanos qué necesitas y un especialista te contacta en menos de 24 horas.'}
        </p>
      </div>
      <a
        href="#contacto"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-cyan-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-600 focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2 focus:ring-offset-granite-50"
      >
        Solicitar cotización
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <p class="mt-8 text-sm text-granite-500">
      Los nombres y logos de clientes son propiedad de sus respectivos dueños.
    </p>
  </div>
</section>

<script>
  import anime from 'animejs';

  const section = document.querySelector<HTMLElement>('[data-clients-section]');
  if (section) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const line = section.querySelector<HTMLElement>('[data-clients-line]');
    const eyebrow = section.querySelector<HTMLElement>('[data-clients-eyebrow]');
    const heading = section.querySelector<HTMLElement>('[data-clients-heading]');
    const lede = section.querySelector<HTMLElement>('[data-clients-lede]');
    const chips = section.querySelectorAll<HTMLElement>('[data-clients-chip]');
    const cards = section.querySelectorAll<HTMLElement>('[data-client-card]');
    const cta = section.querySelector<HTMLElement>('[data-clients-cta]');

    const reset = () => {
      if (line) anime.set(line, { scaleX: 0 });
      if (eyebrow) anime.set(eyebrow, { opacity: 0, translateX: -8 });
      if (heading) anime.set(heading, { opacity: 0, translateY: 24 });
      if (lede) anime.set(lede, { opacity: 0, translateY: 18 });
      if (chips.length) anime.set(chips, { opacity: 0, translateY: 12 });
      if (cards.length) anime.set(cards, { opacity: 0, translateY: 30, scale: 0.94 });
      if (cta) anime.set(cta, { opacity: 0, translateY: 16 });
    };

    const playIntro = () => {
      const tl = anime.timeline({ easing: 'easeOutCubic' });

      if (line) {
        tl.add({
          targets: line,
          scaleX: [0, 1],
          duration: 600,
          easing: 'easeOutQuart',
        });
      }
      if (eyebrow) {
        tl.add(
          {
            targets: eyebrow,
            opacity: [0, 1],
            translateX: [-8, 0],
            duration: 500,
          },
          '-=400',
        );
      }
      if (heading) {
        tl.add(
          {
            targets: heading,
            opacity: [0, 1],
            translateY: [24, 0],
            duration: 700,
          },
          '-=300',
        );
      }
      if (lede) {
        tl.add(
          {
            targets: lede,
            opacity: [0, 1],
            translateY: [18, 0],
            duration: 600,
          },
          '-=400',
        );
      }
      if (chips.length) {
        tl.add(
          {
            targets: chips,
            opacity: [0, 1],
            translateY: [12, 0],
            duration: 500,
            delay: anime.stagger(60),
          },
          '-=300',
        );
      }
      if (cards.length) {
        tl.add(
          {
            targets: cards,
            opacity: [0, 1],
            translateY: [30, 0],
            scale: [0.94, 1],
            duration: 760,
            delay: anime.stagger(110, { grid: [3, 3], from: 'center' }),
            complete: () => {
              cards.forEach((c) => {
                c.style.transform = '';
              });
            },
          },
          '-=200',
        );
      }
      if (cta) {
        tl.add(
          {
            targets: cta,
            opacity: [0, 1],
            translateY: [16, 0],
            duration: 600,
          },
          '-=400',
        );
      }
    };

    if (prefersReducedMotion) {
      [line, eyebrow, heading, lede, cta, ...chips, ...cards].forEach((el) => {
        if (el) el.style.opacity = '1';
      });
      if (line) line.style.transform = 'scaleX(1)';
    } else {
      reset();

      let hasPlayed = false;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.intersectionRatio >= 0.15 && !hasPlayed) {
              hasPlayed = true;
              playIntro();
            } else if (entry.intersectionRatio <= 0 && hasPlayed) {
              hasPlayed = false;
              reset();
            }
          });
        },
        { threshold: [0, 0.15] },
      );
      observer.observe(section);
    }

    cards.forEach((card) => {
      const img = card.querySelector<HTMLElement>('img');
      if (prefersReducedMotion) return;

      const trailBL = card.querySelector<HTMLElement>('[data-trail="bl"]');
      const trailBR = card.querySelector<HTMLElement>('[data-trail="br"]');
      const trailL = card.querySelector<HTMLElement>('[data-trail="l"]');
      const trailR = card.querySelector<HTMLElement>('[data-trail="r"]');
      const trailTL = card.querySelector<HTMLElement>('[data-trail="tl"]');
      const trailTR = card.querySelector<HTMLElement>('[data-trail="tr"]');
      const trailBottom = [trailBL, trailBR].filter((el): el is HTMLElement => !!el);
      const trailSides = [trailL, trailR].filter((el): el is HTMLElement => !!el);
      const trailTop = [trailTL, trailTR].filter((el): el is HTMLElement => !!el);
      const allTrails = [...trailBottom, ...trailSides, ...trailTop];

      card.addEventListener('mouseenter', () => {
        anime.remove(card);
        anime({
          targets: card,
          translateY: -6,
          duration: 360,
          easing: 'easeOutBack',
        });
        if (img) {
          anime.remove(img);
          anime({
            targets: img,
            scale: 1.06,
            duration: 380,
            easing: 'easeOutBack',
          });
        }

        if (allTrails.length) {
          anime.remove(allTrails);
          const tl = anime.timeline({ easing: 'easeOutQuad' });
          if (trailBottom.length) {
            tl.add({ targets: trailBottom, scaleX: [0, 1], duration: 220 });
          }
          if (trailSides.length) {
            tl.add({ targets: trailSides, scaleY: [0, 1], duration: 280 }, '-=60');
          }
          if (trailTop.length) {
            tl.add({ targets: trailTop, scaleX: [0, 1], duration: 220 }, '-=60');
          }
        }
      });

      card.addEventListener('mouseleave', () => {
        anime.remove(card);
        anime({
          targets: card,
          translateY: 0,
          duration: 320,
          easing: 'easeOutQuad',
        });
        if (img) {
          anime.remove(img);
          anime({
            targets: img,
            scale: 1,
            duration: 320,
            easing: 'easeOutQuad',
          });
        }

        if (allTrails.length) {
          anime.remove(allTrails);
          const tl = anime.timeline({ easing: 'easeInQuad' });
          if (trailTop.length) {
            tl.add({ targets: trailTop, scaleX: 0, duration: 200 });
          }
          if (trailSides.length) {
            tl.add({ targets: trailSides, scaleY: 0, duration: 240 }, '-=60');
          }
          if (trailBottom.length) {
            tl.add({ targets: trailBottom, scaleX: 0, duration: 200 }, '-=60');
          }
        }
      });
    });
  }
</script>
